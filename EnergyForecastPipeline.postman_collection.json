{
  "info": {
    "name": "Energy Forecast Pipeline API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "BEMS backend, JWT auth. Select an environment, run Auth > Login, then run a folder top-to-bottom - IDs chain automatically via collection variables."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8022"
    },
    {
      "key": "admin_email",
      "value": "admin@energy.local"
    },
    {
      "key": "admin_password",
      "value": "Admin12345"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "dataset_id",
      "value": "1"
    },
    {
      "key": "cleaned_id",
      "value": "2"
    },
    {
      "key": "outlier_id",
      "value": "3"
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "forecast_id",
      "value": "4"
    },
    {
      "key": "result_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/accounts/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "login",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Saves {{access_token}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.tokens && d.tokens.access) {",
                  "  pm.collectionVariables.set('access_token', d.tokens.access);",
                  "  console.log('token saved');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/accounts/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "refresh",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Uses the refresh_token cookie from Login."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/accounts/logout/",
