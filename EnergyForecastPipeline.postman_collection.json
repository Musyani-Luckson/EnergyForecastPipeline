    {
      "name": "Datasets",
      "item": [
        {
          "name": "Upload dataset (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/datasets/upload/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "datasets",
                "upload",
                ""
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/energy.csv"
                }
              ]
            },
            "description": "Field 'file' = CSV/XLSX (Date, Daily_kWh). Saves dataset_id + run_id."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = (pm.response.json().data) || {};",
                  "if (d.id !== undefined && d.id !== null) pm.collectionVariables.set('dataset_id', d.id);",
                  "if (d.run_id !== undefined && d.run_id !== null) pm.collectionVariables.set('run_id', d.run_id);"
                ]
              }
            }
          ]
        },
